# docker compose 变量：复制为 deploy/.env 后修改
# ---- 平台 ----
KAIP_PORT=8080
KAIP_SYSLOG_PORT=5514
# KSE HTTP 地址：与宿主机同机用 http://127.0.0.1:1234；KSE 在另一台服务器用 http://<KSE IP>:1234
KAIP_KSE_URL=http://127.0.0.1:1234
# KSE 在另一台服务器、扫描目录经 NFS 挂载时：KSE 主机上的挂载点（见 deploy/kse-share.sh）；同机留空
KAIP_KSE_SCAN_DIR_REMOTE=
# 宿主机上的扫描目录（须对 UID 10001 可写：install -d -o 10001 -g 10001 -m 0775 /opt/kaspersky/scanqueue）
KAIP_SCAN_DIR=/opt/kaspersky/scanqueue

# ---- 容器化 OpenCode（--profile agent）----
# 平台地址（容器内访问宿主机用 host.docker.internal；端口与 KAIP_PORT 一致）
KAIP_SERVER_FOR_AGENT=http://host.docker.internal:8080
# 注册令牌不写在这里：首次注册前写入 deploy/kaip_enroll_token.txt（compose secrets，不进入容器环境变量）
OPENCODE_VERSION=1.15.13
OPENCODE_HOSTNAME=oc-kaip
WORKSPACE=./workspace

# ---- 无法访问 Docker Hub 时的基础镜像 ----
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-slim
