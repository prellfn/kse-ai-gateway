# ===== KAIP 平台配置 =====
# 引擎模式：kse = 真实 Kaspersky Scan Engine；mock = 内置模拟引擎（仅演示）
KAIP_KSE_MODE=kse
# KSE HTTP 模式地址（KSE Web UI → Settings → Service 中设置的监听地址；KSE 默认只监听本机 socket，须先改为 127.0.0.1:1234）
KAIP_KSE_URL=http://127.0.0.1:1234
# KSE Web UI → Settings → Authorization 生成的 Token（开启 Bearer 前缀时 KAIP_KSE_BEARER=true）
KAIP_KSE_TOKEN=
KAIP_KSE_BEARER=true
KAIP_KSE_VERIFY_TLS=false
# 单对象扫描超时（毫秒），大模型文件需调大，并同步调整 KSE 的 SessionTimeout
KAIP_KSE_TIMEOUT_MS=600000
# scanfile 目录：平台对其有写权限；KSE 同机时直接加入 KSE「允许扫描的目录」
KAIP_KSE_SCAN_DIR=/opt/kaspersky/scanqueue
# KSE 在另一台服务器：上面的目录经 NFS 共享并挂载到 KSE 主机，这里填 KSE 主机上的挂载路径（并加入 KSE 允许扫描的目录）；同机留空
KAIP_KSE_SCAN_DIR_REMOTE=
# 达到该字节数改用 scanfile（避免 base64 膨胀），默认 25MB；0 = 全部用 scanmemory
KAIP_KSE_SCANFILE_THRESHOLD=26214400

# 管理员（为空则首次启动随机生成，写入 $KAIP_DATA_DIR/initial_admin_password.txt）
KAIP_ADMIN_USER=admin
KAIP_ADMIN_PASSWORD=
KAIP_DATA_DIR=/var/lib/kaip

# 内置 syslog 接收（KSE 日志 → 平台），UDP
KAIP_SYSLOG_LISTEN=true
KAIP_SYSLOG_PORT=5514
# 供应链上传上限（MB）
KAIP_MAX_UPLOAD_MB=40960
