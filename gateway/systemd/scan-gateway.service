[Unit]
Description=KSE Scan Gateway (Kaspersky Scan Engine wrapper)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-stack/scan-gateway
EnvironmentFile=-/opt/ai-stack/scan-gateway/.env
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/kse-ai-stack/scan-gateway.log
StandardError=append:/var/log/kse-ai-stack/scan-gateway.log

[Install]
WantedBy=multi-user.target
