[Unit]
Description=KSE Quarantine Review Console
After=network.target scan-gateway.service
Wants=scan-gateway.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-stack/quarantine-console
EnvironmentFile=-/opt/ai-stack/quarantine-console/.env
ExecStart=/usr/bin/python3 app.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/kse-ai-stack/quarantine-console.log
StandardError=append:/var/log/kse-ai-stack/quarantine-console.log

[Install]
WantedBy=multi-user.target
