# ===========================================================================
# kse-ai-gateway 环境变量模板
#
# 部署位置: /opt/ai-stack/<service>/.env  (权限 600)
# 复制后按实际环境修改; 真实密钥请勿提交到仓库
# ===========================================================================

# ---- KSE (卡巴斯基扫描引擎) ----
# KSE API 地址。网关与 KSE 同机时用 https://127.0.0.1:8443;
# 分离部署时填 KSE 主机的地址, 例如 http://192.168.1.122:1234
KSE_URL=http://127.0.0.1:8443

# 扫描模式:
#   auto   (推荐) 先试路径扫描, 遇到 KSE 拒绝跨机路径扫描时自动回退到内存扫描
#   file   仅路径扫描 —— 要求网关与 KSE 在同一台机器
#   memory 仅内存扫描 —— 跨机部署必须用这个 (内容 base64 传输)
KSE_MODE=auto

# KSE 明文 Token (由 Web UI -> Settings -> Authorization -> Generate token 生成)。
# KSE 未开启 Token 认证时留空即可。
KSE_TOKEN=

# 单次扫描超时 (秒)
KSE_TIMEOUT=120

# 自签证书校验。KSE 使用自签证书时置为 false
KSE_VERIFY_TLS=false

# ---- 目录 ----
SCAN_QUEUE=/opt/kaspersky/scanqueue
QUARANTINE=/opt/kaspersky/quarantine
# 允许扫描的目录, 逗号分隔 (默认仅扫描队列)
ALLOWED_SCAN_DIRS=/opt/kaspersky/scanqueue,/opt/kaspersky/quarantine
AUDIT_LOG=/opt/ai-stack/scan-gateway/logs/audit.jsonl

# ---- 监听 ----
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000

# ---- 限制 ----
MAX_FILE_SIZE=104857600
MAX_UPLOAD_SIZE=104857600

# ---- 压缩包解包保护 (防压缩包炸弹) ----
MAX_ARCHIVE_MEMBERS=5000
MAX_ARCHIVE_UNPACKED=524288000
MAX_COMPRESSION_RATIO=100

# ---- AnythingLLM (Upload Gateway) ----
ANYTHINGLLM_URL=http://127.0.0.1:3001
ANYTHINGLLM_API_KEY=
WORKSPACE_SLUG=
# 无 AnythingLLM 时设为 false, 仅验证扫描链路不转发入库
FORWARD_ENABLED=false

# ---- MCP Server ----
KSE_SCAN_GATEWAY=http://127.0.0.1:8000
KSE_SCAN_TIMEOUT=300
KSE_MAX_TEXT_BYTES=52428800
MCP_PROTOCOL_VERSION=2024-11-05

# ---- 隔离区复核台 ----
SCAN_GATEWAY=http://127.0.0.1:8000
TEMPLATE_DIR=templates
MAX_AUDIT_LINES=2000
