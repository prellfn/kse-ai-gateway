# ---- KSE (卡巴斯基扫描引擎) ----
KSE_URL=https://127.0.0.1:8443
# 明文 Token, 由 KSE Web UI -> Settings -> Authorization -> Generate token 生成
KSE_TOKEN=your-kse-plaintext-token
KSE_TIMEOUT=120
KSE_VERIFY_TLS=false

# ---- 目录 ----
SCAN_QUEUE=/opt/kaspersky/scanqueue
QUARANTINE=/opt/kaspersky/quarantine
# 允许扫描的目录, 逗号分隔 (默认仅扫描队列)
ALLOWED_SCAN_DIRS=/opt/kaspersky/scanqueue,/root/ai-stack/ollama/models/blobs
AUDIT_LOG=/opt/ai-stack/scan-gateway/logs/audit.jsonl

# ---- 上传限制 ----
MAX_FILE_SIZE=104857600
MAX_UPLOAD_SIZE=104857600

# ---- AnythingLLM ----
ANYTHINGLLM_URL=http://10.0.0.1:3001
ANYTHINGLLM_API_KEY=your-anythingllm-api-key
WORKSPACE_SLUG=your-workspace-slug
# ---- MCP Server (Codex / Claude Code 等原生接入) ----
KSE_SCAN_GATEWAY=http://127.0.0.1:8000
KSE_SCAN_TIMEOUT=300
KSE_MAX_TEXT_BYTES=52428800

# ---- 隔离区复核台 (:8004) ----
# 复核台默认无鉴权, 请仅部署在内网或置于反向代理之后
MAX_AUDIT_LINES=2000

# ---- 压缩包解包保护 (防压缩包炸弹) ----
MAX_ARCHIVE_MEMBERS=5000
MAX_ARCHIVE_UNPACKED=524288000
MAX_COMPRESSION_RATIO=100